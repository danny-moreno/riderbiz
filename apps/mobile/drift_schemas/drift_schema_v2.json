        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"logistics_operators\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
