  "fixed_sql": [
    {
      "name": "logistics_operators",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"logistics_operators\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "operator_tariffs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operator_tariffs\" (\"id\" TEXT NOT NULL, \"operator_id\" TEXT NOT NULL REFERENCES logistics_operators (id) ON DELETE RESTRICT, \"version\" INTEGER NOT NULL, \"unit_price_minor\" INTEGER NOT NULL CHECK (unit_price_minor >= 0), \"currency\" TEXT NOT NULL, \"valid_from\" INTEGER NOT NULL, \"valid_until\" INTEGER NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"operator_id\", \"version\"));"
        }
      ]
    },
    {
      "name": "operator_label_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operator_label_profiles\" (\"id\" TEXT NOT NULL, \"operator_id\" TEXT NOT NULL REFERENCES logistics_operators (id) ON DELETE CASCADE, \"marker\" TEXT NOT NULL, \"priority\" INTEGER NOT NULL DEFAULT 0, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "delivery_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"delivery_runs\" (\"id\" TEXT NOT NULL, \"operator_id\" TEXT NOT NULL REFERENCES logistics_operators (id) ON DELETE RESTRICT, \"started_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "synthetic_packages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"synthetic_packages\" (\"id\" TEXT NOT NULL, \"delivery_run_id\" TEXT NOT NULL REFERENCES delivery_runs (id) ON DELETE CASCADE, \"status\" TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'delivered', 'failed')), \"external_reference\" TEXT NULL, \"identified_operator_id\" TEXT NULL REFERENCES logistics_operators (id) ON DELETE RESTRICT, \"identification_status\" TEXT NOT NULL DEFAULT 'unknown' CHECK (identification_status IN ('identified', 'low_confidence', 'unknown', 'manual')), \"identification_confidence\" REAL NULL, \"tariff_id\" TEXT NULL REFERENCES operator_tariffs (id) ON DELETE RESTRICT, \"unit_price_minor_snapshot\" INTEGER NULL, \"currency_snapshot\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"needs_sync\" INTEGER NOT NULL DEFAULT 1 CHECK (\"needs_sync\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "delivery_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"delivery_events\" (\"id\" TEXT NOT NULL, \"package_id\" TEXT NOT NULL REFERENCES synthetic_packages (id) ON DELETE CASCADE, \"event_type\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"needs_sync\" INTEGER NOT NULL DEFAULT 1 CHECK (\"needs_sync\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
}